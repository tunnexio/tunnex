# Tunnex.io environment. Copy to .env (`make up` does this automatically).
# First-boot bootstrap (S0.3) will auto-generate real secrets; these are dev defaults.

# --- Core ---
TUNNEX_ENV=development
TUNNEX_LOG_LEVEL=info

# --- Postgres ---
POSTGRES_USER=tunnex
POSTGRES_PASSWORD=tunnex_dev_password
POSTGRES_DB=tunnex
# Consumed by the API (wired to the DB in EPIC 1).
DATABASE_URL=postgres://tunnex:tunnex_dev_password@postgres:5432/tunnex?sslmode=disable

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API ---
TUNNEX_API_ADDR=:8080
# Public base URL for email links (verify email, password reset, invites). The
# localhost default ONLY works when the browser runs on the same host — on a remote
# deploy set this to the server's public URL (e.g. https://tunnex.example.com), or
# email links will be unreachable. The API warns loudly at boot if left at localhost.
APP_BASE_URL=http://localhost
# Optional deployment-wide raw mTLS endpoint used in newly generated gateway commands.
# Keep this hostname DNS-only or behind TCP passthrough on port 8443.
TUNNEX_GATEWAY_CONTROL_URL=
# Deployment IPv6 ULA pool used for dual-stack tunnel addresses.
TUNNEX_IPV6_POOL_CIDR=fd7a:1b2c:3d4e::/48

# --- Node agent ---
TUNNEX_API_URL=http://api:8080
# One-time join token exchanged for an mTLS cert in S3.1 (empty for the stub).
TUNNEX_JOIN_TOKEN=

# --- Mail ---
# ⛔ NO DEFAULT. Empty means email is DISABLED: the API says so loudly at startup, /meta
# reports it, and the invite screen warns before you act. Invitations are the only way people join a
# deployment, so a fake mailer here would make the product unusable while every screen reported success.
# Configure SMTP_HOST, SMTP_PORT, and SMTP_FROM for local development as well.
# ⛔ SMTP_HOST SET MEANS MAIL IS SENT. Nothing else overrides that — not TUNNEX_ENV, not any dev flag.
# ⚠ PORT 587, NOT 465. The Go standard library dials plaintext and upgrades via STARTTLS; it has no
#   implicit-TLS path, so an SMTPS port (465) will hang or error. This cannot be fixed by configuration.
# ⚠ SMTP_FROM must be an address your provider will let you send as, or it refuses with an error that
#   looks exactly like a wrong password.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=no-reply@tunnex.local

# Optional signed release descriptor verification for the admin Upgrade Center.
# The private signing key remains in CI secret storage; only this public key is deployed.
TUNNEX_RELEASE_PUBLIC_KEY=b48ff99923c43052ade580cdca63952690f07f08372c35814baa44cb84d674a0
TUNNEX_RELEASE_KEY_ID=release-2026-08-01
# Online discovery is a signed pointer only. Set URL empty or UPDATE_CHECK=false
# for a deliberately air-gapped deployment; local descriptor verification stays on.
TUNNEX_RELEASE_CATALOG_URL=https://github.com/tunnexio/tunnex/releases/download/tunnex-updates/release.json
TUNNEX_RELEASE_UPDATE_CHECK=true

# --- WireGuard data plane (node agent) ---
# Public endpoint (host:port) that client configs dial to reach this gateway.
# MUST be reachable by your clients: set it to the node's public IP/hostname and
# published WG UDP port in production (e.g. vpn.example.com:51820). The compose
# default uses the container service name, which works for on-network clients.
# TUNNEX_NODE_ENDPOINT=vpn.example.com:51820

# --- Secrets ---
# The master encryption key, session secret, and WireGuard server key are
# auto-generated on first boot and persisted (0600) on the dedicated
# `tunnex_secrets` volume at TUNNEX_SECRETS_DIR. They are NOT set via env.
# Override the location only if you know what you are doing:
# TUNNEX_SECRETS_DIR=/var/lib/tunnex/secrets

# MAIL_DEV_LOG tees a copy of every outgoing message to the log IN ADDITION to sending it. Default off.
#
# ⛔ NEVER SET THIS ON A DEPLOYMENT. The logged copy contains the message BODY, and invitation,
# verification and password-reset bodies are links that WORK — a working credential in a shipped,
# searchable log.
#
# ⚠ It does NOT disable sending, and never did. It used to be switched on by TUNNEX_ENV being anything
# other than "production", which meant a correctly-configured rig produced a mailer labelled `smtp+log`
# and a log line reading "email_not_sent_logged" while mail was leaving normally. One flag must not
# govern two unrelated things; this one governs exactly itself.
MAIL_DEV_LOG=false
