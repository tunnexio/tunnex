# Nonshipping local SA-0 fixture; no host dependency installation.
FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
RUN apk add --no-cache ca-certificates wireguard-tools iproute2 nftables iptables openvpn openssh python3 \
 && adduser -D -s /bin/sh fixture && passwd -d fixture
