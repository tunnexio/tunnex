[Unit]
Description=Owned Azure qualification startup ordering
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/libexec/tunnex-azure-owned-boot
TimeoutStartSec=60
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
