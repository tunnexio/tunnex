# Dependencies
# Dependency directories and task-local dependency symlinks are both generated.
node_modules
.pnpm-store/

# Build output
dist/
build/
out/

*.tsbuildinfo
apps/web/dist/
bin/

# Go
*.exe
*.test
*.out
vendor/

# Env & secrets (never commit)
.env
.env.local
*.local

# Box-walk scratch: WireGuard configs carry device PRIVATE KEYS — gitignored AT
# CREATION so a walk never commits key material (walk EVIDENCE lives in
# walk-artifacts/ as nft/pcap/json; scratch keys stay local-only).
*.wgconf
walk-artifacts/**/scratch/
walk-artifacts/**/*.conf
# Runtime secrets material only — ROOT-ANCHORED so it never eats the
# apps/api/internal/secrets SOURCE package (that unanchored `secrets/` silently
# kept the S0.3 crypto code out of git and broke every fresh clone / CI build).
/secrets/
/data/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Turbo
.turbo/

# Logs
*.log
npm-debug.log*

# tsc -b build artifacts
*.tsbuildinfo
apps/web/vite.config.js
apps/web/vite.config.d.ts

# Go build outputs accidentally producible at package roots (never commit)
/apps/api/server
/apps/api/seed
/apps/node/agent

# Historical tunnel scratch (may contain private keys)
S.conf

# stray go-build binary (cmd/walk-bootstrap dev tool)
/apps/api/walk-bootstrap

# S10.2 GitOps walk scratch (CR manifests + any pasted machine token) — evidence goes in walk-artifacts/
/walk/
/walk-leg4/

# S11 walk scratch key material — a deliberately-wrong master key for the negative restore leg.
# Gitignored AT CREATION, per the walk's own condition: never commit key material, even wrong keys
# (a committed 'wrong' key teaches the next reader that committing keys is normal).
wrong-master.key
*-master.key
walk-artifacts/**/*.key

# stray `go build ./cmd/...` outputs (S11)
/apps/api/preflight
/apps/api/backupctl

# S14.1: emitted design tokens (built from packages/shared/src/tokens.ts by `build:tokens`)
/packages/shared/dist/

walk-artifacts/sso-improvement/local-runtime/
