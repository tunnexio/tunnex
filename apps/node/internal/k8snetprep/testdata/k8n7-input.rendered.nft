add table ip tunnex
flush table ip tunnex
table ip tunnex {
  chain tunnex_posture_owner {
    counter comment "tunnex_host_posture_v1"
  }

  chain postrouting {
    type nat hook postrouting priority srcnat - 1; policy accept;
    ip saddr 100.65.0.2/32 oifname != "wg0" masquerade
  }
  chain input {
    type filter hook input priority filter; policy accept;
    iifname "wg0" ct direction reply ct state established,related counter accept comment "tunnex_input_reply"
    iifname "wg0" fib daddr . iif type local udp dport 53 counter accept comment "tunnex_input_dns"
    iifname "wg0" fib daddr . iif type local tcp dport 53 counter accept comment "tunnex_input_dns"
    iifname "wg0" counter drop comment "tunnex_input_tunnel_drop"
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    ct state invalid counter drop comment "tunnex_ct_invalid_drop"
    iifname != "wg0" oifname != "wg0" counter accept comment "tunnex_native_forward_passthrough"

    iifname "wg0" oifname "wg0" tcp flags syn tcp option maxseg size set rt mtu
    ip saddr 10.99.0.2 ct original ip daddr 10.70.0.0/24 meta l4proto tcp ct original proto-dst 10250 counter accept
    counter comment "tunnex_default_drop"
  }
}
add table ip6 tunnex
flush table ip6 tunnex
table ip6 tunnex {
  chain tunnex_posture_owner {
    counter comment "tunnex_host_posture_v1"
  }

  chain postrouting {
    type nat hook postrouting priority srcnat - 1; policy accept;
    ip6 saddr fd00:65::2/128 oifname != "wg0" masquerade
  }
  chain input {
    type filter hook input priority filter; policy accept;
    iifname "wg0" ct direction reply ct state established,related counter accept comment "tunnex_input_reply"
    iifname "wg0" fib daddr . iif type local udp dport 53 counter accept comment "tunnex_input_dns"
    iifname "wg0" fib daddr . iif type local tcp dport 53 counter accept comment "tunnex_input_dns"
    iifname "wg0" counter drop comment "tunnex_input_tunnel_drop"
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    ct state invalid counter drop comment "tunnex_ct_invalid_drop"
    iifname != "wg0" oifname != "wg0" counter accept comment "tunnex_native_forward_passthrough"

    counter comment "tunnex_default_drop"
  }
}
