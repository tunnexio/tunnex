[Unit]
Description=Tunnex managed agent runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=6

[Service]
Type=simple
ExecStart=/usr/local/bin/tunnex-agent-runtime
# F04 narrow slice: the installer owns root:root 0600 config, credential, and
# durable state. A privileged helper split is deferred; root is bounded below
# to the WireGuard device and the three explicit write paths.
User=root
Group=root
# Ubuntu's enforced wg-quick AppArmor profile transitions into child profiles
# for ip/wg. no_new_privs blocks those transitions before CAP_NET_ADMIN is used.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DeviceAllow=/dev/net/tun rw
ReadWritePaths=/etc/wireguard /etc/tunnex-agent /var/lib/tunnex-agent
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
