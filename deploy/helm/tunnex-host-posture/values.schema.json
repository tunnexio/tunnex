{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "tunnex-host-posture values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "agent", "tag", "digest", "pullPolicy", "pullSecrets"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "acknowledgePrivileged": { "type": "boolean", "const": true },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kubernetes.io/os"],
      "properties": {
        "kubernetes.io/os": { "type": "string", "const": "linux" }
      }
    },
    "tolerations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator"],
        "properties": {
          "operator": { "type": "string", "const": "Exists" }
        }
      }
    },
    "affinity": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "reconcileInterval": { "type": "string", "pattern": "^([1-9][0-9]*)(ms|s)$" },
    "apiRequestTimeout": { "type": "string", "pattern": "^([1-9][0-9]*)(ms|s)$" },
    "maxOwners": { "type": "integer", "minimum": 1, "maximum": 32 },
    "resources": { "type": "object" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean", "const": true },
        "name": { "type": "string", "const": "" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": { "create": { "type": "boolean", "const": true } }
    },
    "rolloutRevision": { "type": "string", "maxLength": 256 }
  },
  "required": [
    "image", "acknowledgePrivileged", "nodeSelector", "tolerations", "affinity",
    "reconcileInterval", "apiRequestTimeout", "maxOwners", "resources",
    "serviceAccount", "rbac", "rolloutRevision"
  ]
}
