{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "tunnex-gateway values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "agent", "tag", "digest", "pullPolicy", "pullSecrets", "preflight"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        },
        "preflight": { "type": "string", "pattern": "^$|^[^\\s@]+@sha256:[a-f0-9]{64}$" }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiURL", "agentURL", "serverName"],
      "properties": {
        "apiURL": { "type": "string", "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?|\\[[0-9A-Fa-f:]+\\])(?::[0-9]{1,5})?(?:/[^\\s]*)?$" },
        "agentURL": { "type": "string", "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?|\\[[0-9A-Fa-f:]+\\])(?::[0-9]{1,5})?(?:/[^\\s]*)?$" },
        "serverName": { "type": "string", "minLength": 1 }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "existingSecret", "secretOptional"],
      "properties": {
        "mode": { "type": "string", "enum": ["enroll", "reuse"] },
        "existingSecret": { "type": "string" },
        "secretOptional": { "type": "boolean" }
      }
    },
    "existingJoinTokenSecret": { "type": "string" },
    "joinTokenKey": { "type": "string", "minLength": 1 },
    "joinToken": { "type": "string" },
    "endpoint": {
      "type": "string",
      "pattern": "^$|^([A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?|\\[[0-9A-Fa-f:]+\\]):[0-9]{1,5}$"
    },
    "nodeName": { "type": "string" },
    "wireguard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "loadBalancerIP", "nodePort", "annotations"],
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "NodePort" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "nodePort": { "minimum": 30000, "maximum": 32767 }
            }
          }
        }
      ],
      "properties": {
        "type": { "type": "string", "enum": ["LoadBalancer", "NodePort"] },
        "loadBalancerIP": { "type": "string" },
        "nodePort": {
          "type": "integer",
          "anyOf": [
            { "const": 0 },
            { "minimum": 30000, "maximum": 32767 }
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "size", "storageClass", "existingClaim", "retain", "provenance"],
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" },
        "existingClaim": { "type": "string" },
        "retain": { "type": "boolean" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["organizationID", "lifecycleClaim"],
          "properties": {
            "organizationID": { "type": "string", "pattern": "^$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "lifecycleClaim": { "type": "string", "pattern": "^$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "dnsProbe"],
      "properties": {
        "enabled": { "type": "boolean" },
        "dnsProbe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
        }
      }
    },
    "acknowledgePrivileged": { "type": "boolean", "const": true },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "affinity": { "type": "object" },
    "resources": { "type": "object" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "logLevel": { "type": "string", "minLength": 1 },
    "rolloutRevision": { "type": "string", "maxLength": 256 },
    "reportInterval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" }
  },
  "required": [
    "image",
    "controlPlane",
    "enrollment",
    "joinTokenKey",
    "wireguard",
    "service",
    "persistence",
    "preflight",
    "acknowledgePrivileged",
    "serviceAccount",
    "rbac",
    "logLevel",
    "rolloutRevision",
    "reportInterval"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "enrollment": {
            "properties": { "mode": { "const": "enroll" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "nodeName": { "minLength": 1 },
          "persistence": {
            "properties": { "existingClaim": { "maxLength": 0 } }
          }
        },
        "oneOf": [
          {
            "properties": {
              "enrollment": { "properties": { "existingSecret": { "minLength": 1 } } },
              "existingJoinTokenSecret": { "maxLength": 0 },
              "joinToken": { "maxLength": 0 }
            }
          },
          {
            "properties": {
              "enrollment": { "properties": { "existingSecret": { "maxLength": 0 } } },
              "existingJoinTokenSecret": { "minLength": 1 },
              "joinToken": { "maxLength": 0 }
            }
          },
          {
            "properties": {
              "enrollment": { "properties": { "existingSecret": { "maxLength": 0 } } },
              "existingJoinTokenSecret": { "maxLength": 0 },
              "joinToken": { "minLength": 1 }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "enrollment": {
            "properties": { "mode": { "const": "reuse" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "enrollment": {
            "properties": { "existingSecret": { "maxLength": 0 } }
          },
          "existingJoinTokenSecret": { "maxLength": 0 },
          "joinToken": { "maxLength": 0 },
          "persistence": {
            "properties": {
              "enabled": { "const": true },
              "existingClaim": { "minLength": 1 },
              "provenance": {
                "properties": {
                  "organizationID": { "maxLength": 0 },
                  "lifecycleClaim": { "maxLength": 0 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "persistence": {
            "properties": {
              "provenance": {
                "properties": { "organizationID": { "minLength": 1 } },
                "required": ["organizationID"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "persistence": {
            "properties": {
              "provenance": {
                "properties": { "lifecycleClaim": { "minLength": 1 } }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "persistence": {
            "properties": {
              "provenance": {
                "properties": { "lifecycleClaim": { "maxLength": 0 } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "service": {
            "properties": { "type": { "const": "NodePort" } },
            "required": ["type"]
          }
        }
      },
      "then": {
        "properties": { "endpoint": { "minLength": 1 } }
      }
    }
  ]
}
