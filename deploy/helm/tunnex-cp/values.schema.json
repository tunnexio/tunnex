{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "aiGateway": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "providerManagementEnabled": {
          "type": "boolean"
        },
        "enabled": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "secretKeys": {"type": "object", "additionalProperties": false, "required": ["adminUser", "adminPassword", "providerKey", "encryptionKey"], "properties": {
          "adminUser": {"type": "string", "minLength": 1}, "adminPassword": {"type": "string", "minLength": 1}, "providerKey": {"type": "string", "minLength": 1}, "encryptionKey": {"type": "string", "minLength": 1}
        }},
        "providerKeyID": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9_-]+$"},
        "models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9_./:-]+$"}},
        "persistence": {"type": "object", "additionalProperties": false, "properties": {
          "storageClassName": {"type": "string"}, "configSize": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}, "logsSize": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}
        }},
        "dns": {"type": "object", "additionalProperties": false, "properties": {
          "namespaceLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}, "podLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
        }},
        "resources": {"type": "object"}
      },
      "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"existingSecret": {"minLength": 1}}}}]
    }
  },
  "allOf": [{"if": {"properties": {"aiGateway": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}}, "required": ["aiGateway"]}, "then": {"properties": {"api": {"properties": {"replicas": {"const": 1}}}}}}]
}
